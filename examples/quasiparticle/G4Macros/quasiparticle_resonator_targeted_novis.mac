#-----------------------------------------------
# quasiparticle_resonator_targeted_novis.mac
#
# Same event as quasiparticle_resonator_targeted.mac, but with no
# visualization (no display needed). Prints verbose tracking output.
# Run in batch mode:
#   ./g4cmpQuasiparticle ../G4Macros/quasiparticle_resonator_targeted_novis.mac > tracking.log 2>&1
#
# This mimics a targeted single photon pulse in
# the top-left superconducting resonator in our
# geometry, using Debye-energy phonons (36.9 meV).
#------------------------------------------

# Initialize the run
/run/initialize
/run/printProgress 1

# Verbose tracking output (no trajectory drawing)
/tracking/verbose 2

# Toggle phononBounces depending on whether
# you want to see a full event or not.
/g4cmp/phononBounces 1000000
/g4cmp/qpBounces 1000000000

# Uncomment to disable individual processes
#/process/inactivate phononScattering
#/process/inactivate phononDownconversion
/process/inactivate phononPolycrystalElasticScattering
#/process/inactivate qpRecombination
#/process/inactivate qpRadiatesPhonon
#/process/inactivate scPairBreaking
#/process/inactivate qpDiffusion 
#/process/inactivate qpLocalTrapping
#/process/inactivate qpDiffusionTimeStepper

# Generate 1 phonon per event. Place right under the Nb film
/gps/number 1
/gps/particle phononTF
/gps/pos/type Volume
/gps/pos/shape Para
/gps/pos/centre -2.58 1.221 5.0001 mm # Point 1, in film
#/gps/pos/centre -1.85 1.221 5.0001 mm # Point 2, in film

#These spawn phonons from a parallelepiped with the following
#half-dimensions (i.e. very small, 10nm box)
/gps/pos/halfx 0.00001 mm
/gps/pos/halfy 0.00001 mm
/gps/pos/halfz 0.00001 mm

/random/setSeeds 123456 567890

#Spawn 1 phonon per event with 36.9 meV, in random
#directions (isotropically)
/gps/ang/type iso
/gps/ene/type Mono
/gps/energy 0.0369 eV
/gps/number 1
/run/beamOn 3
